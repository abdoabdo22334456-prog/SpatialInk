set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT SPATIALINK_LLVM_ROOT AND DEFINED ENV{SPATIALINK_LLVM_ROOT})
  set(SPATIALINK_LLVM_ROOT "$ENV{SPATIALINK_LLVM_ROOT}" CACHE PATH "LLVM-MinGW root")
endif()
if(NOT SPATIALINK_LLVM_ROOT)
  message(FATAL_ERROR "Set SPATIALINK_LLVM_ROOT to LLVM-MinGW root")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SPATIALINK_LLVM_ROOT)
file(TO_CMAKE_PATH "${SPATIALINK_LLVM_ROOT}" _llvm)
set(CMAKE_C_COMPILER "${_llvm}/bin/x86_64-w64-mingw32-clang.exe")
set(CMAKE_CXX_COMPILER "${_llvm}/bin/x86_64-w64-mingw32-clang++.exe")
set(CMAKE_RC_COMPILER "${_llvm}/bin/x86_64-w64-mingw32-windres.exe")
