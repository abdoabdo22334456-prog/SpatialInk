--- a/src/detail/vst3/parameter.h
+++ b/src/detail/vst3/parameter.h
@@ -41,6 +41,16 @@ class Vst3Parameter : public Steinberg::Vst::Parameter
  public:
   virtual ~Vst3Parameter();
   bool setNormalized(Steinberg::Vst::ParamValue v) override;
+  Steinberg::Vst::ParamValue toPlain(Steinberg::Vst::ParamValue v) const override
+  {
+    if (!std::isfinite(v)) return min_value;
+    return asClapValue(std::fmax(0.0, std::fmin(1.0, v)));
+  }
+  Steinberg::Vst::ParamValue toNormalized(Steinberg::Vst::ParamValue v) const override
+  {
+    if (!std::isfinite(v)) return 0.0;
+    return std::fmax(0.0, std::fmin(1.0, asVst3Value(v)));
+  }
 
